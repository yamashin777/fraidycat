{
  "manifest_version": 3,
  "name": "Fraidycat",
  "version": "1.0.0",
  "description": "YouTube・RSSフィードをまとめてチェックできるフィードリーダー",
  "action": {
    "default_title": "Fraidycatを開く",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
